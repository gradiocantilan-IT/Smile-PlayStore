# ==============================================================================
# SMILE STORE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or configure these variables in your Vercel Project Settings.
# NEVER commit your production .env or service account keys to version control.

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE VARIABLES (Safe for browser bundles)
# ------------------------------------------------------------------------------
# Firebase client configuration (used by admin web login if direct Firebase Auth is used)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRET VARIABLES (NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# Firebase Admin SDK Credentials (Required for Firestore & Auth token verification)
# For Vercel: Provide project ID, client email, and private key (escaped newlines: \n).
# In Google Cloud Run or GCP, Application Default Credentials will be used automatically.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Cloudflare R2 Storage (AWS S3-compatible SDK)
# Obtain these from Cloudflare Dashboard > R2 > Manage R2 API Tokens.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Optional public CDN URL for non-sensitive public assets (never APK binaries)
R2_PUBLIC_BASE_URL=""

# ------------------------------------------------------------------------------
# 3. SECURITY & ACCESS CONTROL (Server secrets)
# ------------------------------------------------------------------------------
# Comma-separated allowlist of email addresses permitted to access the admin dashboard
# Example: admin@smilestore.app,dev@smilestore.app,gradiocantilan@gmail.com
ADMIN_EMAIL_ALLOWLIST="admin@smilestore.app,gradiocantilan@gmail.com"

# High-entropy random secret string used for signing admin session tokens & CSRF cookies
SESSION_SECRET="replace-with-a-64-character-random-hex-string"

# Canonical URL of the marketplace (used for CORS and signed URLs)
APP_BASE_URL="http://localhost:3000"

# Maximum APK upload limit in megabytes (default: 150)
MAX_APK_SIZE_MB="150"
